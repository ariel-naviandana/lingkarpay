# Server
PORT=3001
NODE_ENV=development

# Database lokal (docker compose up -d, port 5433)
DATABASE_URL=postgres://lingkarpay:lingkarpay_dev@localhost:5433/lingkarpay

# Midtrans SANDBOX (isi sendiri, jangan dikirim ke chat / commit)
MIDTRANS_SERVER_KEY=isi-server-key
MIDTRANS_CLIENT_KEY=isi-client-key
# Signature Secret Key (Settings > Access Keys), untuk verifikasi signature notifikasi.
# Isi bila signature dihitung dari kunci ini, bukan dari Server Key.
MIDTRANS_SIGNATURE_KEY=

# Pesanan
ORDER_EXPIRY_MINUTES=60
DEFAULT_ADMIN_FEE=1000

# Halaman tes /dev (matikan di luar development)
DEV_TOOLS=true

# Midtrans Iris (payout sandbox, opsional). Kunci creator dan approver berbeda.
IRIS_ENABLED=false
# IRIS_CREATOR_KEY=
# IRIS_APPROVER_KEY=
# IRIS_OTP=335163

# Modul chain (worker). Akun operator = akun yang men-deploy contract (testnet khusus!).
# CHAIN_NAME=hardhat          # hardhat = node lokal (npx hardhat node), sepolia = testnet
# CHAIN_RPC_URL=http://127.0.0.1:8545
# OPERATOR_PRIVATE_KEY=
# LINGKARPAY_ADDRESS=
