{
  "name": "contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Smart contract LingkarPay (Hardhat 3, node:test, viem). Versi paket mengikuti hasil `npx hardhat --init` (Hardhat 3.21.2).",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test nodejs",
    "typecheck": "hardhat build && tsc --noEmit",
    "deploy:local": "hardhat ignition deploy --network localhost ignition/modules/LingkarPay.ts",
    "deploy:sepolia": "hardhat ignition deploy --network sepolia ignition/modules/LingkarPay.ts",
    "export:sepolia": "hardhat run scripts/export-deployment.ts",
    "node": "hardhat node",
    "inspect": "hardhat run scripts/inspect-circle.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.20.5",
    "hardhat": "^3.21.2",
    "typescript": "~6.0.3",
    "viem": "^2.57.17"
  }
}
